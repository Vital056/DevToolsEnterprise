// Служебная обработка для отладки: подключает собранный отчёт DevToolsEnterprise.erf
// и открывает его стартовую форму без «Файл → Открыть». Путь к .erf передаётся
// параметром запуска клиента: /C "<полный путь к .erf>" (см. scripts\test.ps1).

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПутьКОтчету = СокрЛП(ПараметрЗапуска);
	Если Не ЗначениеЗаполнено(ПутьКОтчету) Тогда
		Сообщить("Не задан путь к отчёту: запустите клиент с параметром /C ""<путь к .erf>"".");
		Возврат;
	КонецЕсли;
	
	ИмяОтчета = ПодключитьОтчет(ПутьКОтчету);
	ОткрытьФорму("ВнешнийОтчет." + ИмяОтчета + ".Форма.Форма");
	Отказ = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПодключитьОтчет(ПутьКОтчету)
	
	Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКОтчету), УникальныйИдентификатор);
	Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
	Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
	Возврат ВнешниеОтчеты.Подключить(Адрес, , Ложь, Защита);
	
КонецФункции
