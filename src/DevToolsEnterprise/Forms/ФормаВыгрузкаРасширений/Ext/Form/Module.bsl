#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокРасширений();

	// Из отчета "Изменения в расширениях" передаются имена выведенных в него расширений.
	Если Параметры.Расширения <> Неопределено Тогда
		Для Каждого ЭлементСписка Из Параметры.Расширения Цикл
			Отбор = Новый Структура("Имя", ЭлементСписка.Значение);
			Для Каждого СтрокаРасширения Из Расширения.НайтиСтроки(Отбор) Цикл
				СтрокаРасширения.Выгрузить = Истина;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Каталог для выгрузки расширений'");
	Диалог.Каталог = Каталог;

	Выбранные = Ждать Диалог.ВыбратьАсинх();
	Если Выбранные <> Неопределено И Выбранные.Количество() > 0 Тогда
		Каталог = Выбранные[0];
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура Выгрузить(Команда)

	// Каждое отмеченное расширение сохраняется в выбранный каталог файлом <Имя>.cfe.
	// Файл с таким именем перезаписывается. Отсутствующий каталог создается.

	ОчиститьСообщения();

	Если Не ЗначениеЗаполнено(Каталог) Тогда
		ПоказатьОшибкуПоля(НСтр("ru = 'Укажите каталог для выгрузки.'"), "Каталог");
		Возврат;
	КонецЕсли;

	Отмеченные = Расширения.НайтиСтроки(Новый Структура("Выгрузить", Истина));
	Если Отмеченные.Количество() = 0 Тогда
		ПоказатьОшибкуПоля(НСтр("ru = 'Отметьте расширения, которые нужно выгрузить.'"), "Расширения");
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого СтрокаРасширения Из Отмеченные Цикл
		Идентификаторы.Добавить(СтрокаРасширения.Идентификатор);
	КонецЦикла;

	Файлы = ФайлыРасширений(Идентификаторы);

	КаталогВыгрузки = Новый Файл(Каталог);
	Если Не Ждать КаталогВыгрузки.СуществуетАсинх() Тогда
		Ждать СоздатьКаталогАсинх(Каталог);
	КонецЕсли;

	ПолучаемыеФайлы = Новый Массив;
	Для Каждого ОписаниеФайла Из Файлы Цикл
		ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ОписаниеФайла.Имя, ОписаниеФайла.Адрес));
	КонецЦикла;

	Полученные = Ждать ПолучитьФайлыССервераАсинх(ПолучаемыеФайлы, Каталог);
	Количество = ?(Полученные = Неопределено, 0, Полученные.Количество());

	ПоказатьОповещениеПользователя(НСтр("ru = 'Выгрузка расширений'"), ,
		СтрШаблон(НСтр("ru = 'Выгружено расширений: %1 в каталог %2'"), Количество, Каталог),
		БиблиотекаКартинок.Информация32);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	УстановитьОтметки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьСписокРасширений();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Все расширения, записанные в информационную базу, в том числе отключенные.
// Отметки строк сохраняются при повторном заполнении.
&НаСервере
Процедура ЗаполнитьСписокРасширений()

	Отмеченные = Новый Соответствие;
	Для Каждого СтрокаРасширения Из Расширения.НайтиСтроки(Новый Структура("Выгрузить", Истина)) Цикл
		Отмеченные.Вставить(СтрокаРасширения.Идентификатор, Истина);
	КонецЦикла;

	Расширения.Очистить();
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных) Цикл
		СтрокаРасширения = Расширения.Добавить();
		СтрокаРасширения.Идентификатор = Строка(Расширение.УникальныйИдентификатор);
		СтрокаРасширения.Выгрузить = Отмеченные[СтрокаРасширения.Идентификатор] = Истина;
		СтрокаРасширения.Имя = Расширение.Имя;
		СтрокаРасширения.Синоним = Расширение.Синоним;
		СтрокаРасширения.Версия = Расширение.Версия;
		СтрокаРасширения.Назначение = Строка(Расширение.Назначение);
		СтрокаРасширения.Активно = Расширение.Активно;
		СтрокаРасширения.БезопасныйРежим = Расширение.БезопасныйРежим = Истина;
	КонецЦикла;

	Расширения.Сортировать("Имя");

КонецПроцедуры

// Помещает данные расширений во временное хранилище формы.
// Чтение данных расширений требует административных прав.
//
// Параметры:
//   Идентификаторы - Массив из Строка - уникальные идентификаторы расширений.
//
// Возвращаемое значение:
//   Массив из Структура - Имя (имя файла .cfe), Адрес (адрес данных во временном хранилище).
//
&НаСервере
Функция ФайлыРасширений(Знач Идентификаторы)

	Результат = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл

		Отбор = Новый Структура("УникальныйИдентификатор", Новый УникальныйИдентификатор(Идентификатор));
		Найденные = РасширенияКонфигурации.Получить(Отбор, ИсточникРасширенийКонфигурации.БазаДанных);
		Если Найденные.Количество() = 0 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Расширение с идентификатором %1 не найдено в базе. Обновите список.'"),
				Идентификатор);
		КонецЕсли;

		Расширение = Найденные[0];
		Адрес = ПоместитьВоВременноеХранилище(Расширение.ПолучитьДанные(), УникальныйИдентификатор);
		Результат.Добавить(Новый Структура("Имя, Адрес", Расширение.Имя + ".cfe", Адрес));

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура УстановитьОтметки(Значение)
	Для Каждого СтрокаРасширения Из Расширения Цикл
		СтрокаРасширения.Выгрузить = Значение;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкуПоля(Текст, Поле)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти
