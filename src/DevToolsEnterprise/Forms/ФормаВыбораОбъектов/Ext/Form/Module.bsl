#Область ОбработчикиСобытийФормы

// Режим (параметр):
//   пусто - объекты всех расширений базы (см. ОбъектыРасширений);
//   "Расширения" - расширения базы, в том числе отключенные.
// Значения из параметра Выбранные отмечены; те из них, которых нет в списке, добавляются в начало,
// чтобы не потеряться.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Выбранные = ОтчетОбъект.РазобратьИменаОбъектов(Параметры.Выбранные);
	ВыборРасширений = Параметры.Режим = "Расширения";

	Отмеченные = Новый Соответствие;
	Для Каждого Имя Из Выбранные Цикл
		Отмеченные.Вставить(НРег(Имя), Истина);
	КонецЦикла;

	Если ВыборРасширений Тогда
		Заголовок = НСтр("ru = 'Выбор расширений'");
		Элементы.ОбъектыПолноеИмя.Заголовок = НСтр("ru = 'Расширение'");
		ЗаполнитьРасширения(Отмеченные);
	Иначе
		Для Каждого ПолноеИмя Из ОтчетОбъект.ОбъектыРасширений() Цикл
			ДобавитьОбъект(Объекты.Добавить(), ПолноеИмя, Отмеченные[НРег(ПолноеИмя)] = Истина);
		КонецЦикла;
	КонецЕсли;

	ВСписке = Новый Соответствие;
	Для Каждого СтрокаОбъекта Из Объекты Цикл
		ВСписке.Вставить(НРег(СтрокаОбъекта.ПолноеИмя), Истина);
	КонецЦикла;

	Индекс = 0;
	Для Каждого Имя Из Выбранные Цикл
		Если ВСписке[НРег(Имя)] = Неопределено Тогда
			СтрокаОбъекта = Объекты.Вставить(Индекс);
			Если ВыборРасширений Тогда
				СтрокаОбъекта.ПолноеИмя = Имя;
				СтрокаОбъекта.Пометка = Истина;
				СтрокаОбъекта.Показывать = Истина;
			Иначе
				ДобавитьОбъект(СтрокаОбъекта, Имя, Истина);
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоискИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ПрименитьПоиск(Текст);
КонецПроцедуры

&НаКлиенте
Процедура ПоискПриИзменении(Элемент)
	ПрименитьПоиск(Поиск);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаОбъекта = Объекты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	СтрокаОбъекта.Пометка = Не СтрокаОбъекта.Пометка;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	Результат = Новый Массив;
	Для Каждого СтрокаОбъекта Из Объекты.НайтиСтроки(Новый Структура("Пометка", Истина)) Цикл
		Результат.Добавить(СтрокаОбъекта.ПолноеИмя);
	КонецЦикла;

	Закрыть(Результат);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	УстановитьОтметки(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьРасширения(Отмеченные)

	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных) Цикл
		СтрокаОбъекта = Объекты.Добавить();
		СтрокаОбъекта.ПолноеИмя = Расширение.Имя;
		СтрокаОбъекта.Синоним = Расширение.Синоним;
		СтрокаОбъекта.Пометка = Отмеченные[НРег(Расширение.Имя)] = Истина;
		СтрокаОбъекта.Показывать = Истина;
	КонецЦикла;
	Объекты.Сортировать("ПолноеИмя");

КонецПроцедуры

&НаСервере
Процедура ДобавитьОбъект(СтрокаОбъекта, ПолноеИмя, Пометка)

	СтрокаОбъекта.ПолноеИмя = ПолноеИмя;
	СтрокаОбъекта.Пометка = Пометка;
	СтрокаОбъекта.Показывать = Истина;

	// Новые объекты отключенных расширений в метаданных сеанса не найдутся - синоним останется пустым.
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных <> Неопределено Тогда
		СтрокаОбъекта.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		СтрокаОбъекта.Синоним = ОбъектМетаданных.Синоним;
	КонецЕсли;

КонецПроцедуры

// Оставляет видимыми строки, в имени или синониме которых есть все слова текста.
&НаКлиенте
Процедура ПрименитьПоиск(Текст)

	Слова = СтрРазделить(НРег(СокрЛП(Текст)), " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Элементы.Объекты.ОтборСтрок = Неопределено;
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОбъекта Из Объекты Цикл
		Представление = НРег(СтрокаОбъекта.ПолноеИмя + " " + СтрокаОбъекта.Синоним);
		Показывать = Истина;
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(Представление, Слово) = 0 Тогда
				Показывать = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		СтрокаОбъекта.Показывать = Показывать;
	КонецЦикла;

	Элементы.Объекты.ОтборСтрок = Новый ФиксированнаяСтруктура("Показывать", Истина);

КонецПроцедуры

// Отметки ставятся и снимаются только у строк, видимых при текущем поиске.
&НаКлиенте
Процедура УстановитьОтметки(Значение)

	ОтборВключен = Элементы.Объекты.ОтборСтрок <> Неопределено;
	Для Каждого СтрокаОбъекта Из Объекты Цикл
		Если Не ОтборВключен Или СтрокаОбъекта.Показывать Тогда
			СтрокаОбъекта.Пометка = Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
