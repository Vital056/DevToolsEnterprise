#Область ОписаниеПеременных

&НаКлиенте
Перем ВсеРасширения; // СписокЗначений - для автоподбора, см. РасширенияБазы.

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// В поле можно перечислить несколько расширений через запятую - как объекты в форме ФормаИзменения:
// подбор идет по тексту после последней запятой (или точки с запятой), выбранное расширение
// дописывается к уже введенным.
&НаКлиенте
Процедура РасширениеАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	ПозицияРазделителя = Макс(СтрНайти(Текст, ",", НаправлениеПоиска.СКонца),
		СтрНайти(Текст, ";", НаправлениеПоиска.СКонца));
	Начало = СокрП(Лев(Текст, ПозицияРазделителя));
	Если ЗначениеЗаполнено(Начало) Тогда
		Начало = Начало + " ";
	КонецЕсли;

	Слова = СтрРазделить(НРег(СокрЛП(Сред(Текст, ПозицияРазделителя + 1))), " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ВсеРасширения = Неопределено Тогда
		ВсеРасширения = РасширенияБазы();
	КонецЕсли;

	// Уже введенные расширения повторно не предлагаются.
	Введенные = Новый Соответствие;
	Для Каждого ВведенноеИмя Из СтрРазделить(НРег(Начало), ",; ", Ложь) Цикл
		Введенные.Вставить(ВведенноеИмя, Истина);
	КонецЦикла;

	// Ищутся расширения, в имени или синониме которых есть все введенные слова.
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ВсеРасширения Цикл
		Если Введенные[НРег(ЭлементСписка.Значение)] = Неопределено
			И СодержитВсеСлова(НРег(ЭлементСписка.Представление), Слова) Тогда
			ДанныеВыбора.Добавить(Начало + ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РасширениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	ЧастиИмени[ЧастиИмени.ВГраница()] = "ФормаВыбораОбъектов";
	ПараметрыВыбора = Новый Структура("Выбранные, Режим", Расширение, "Расширения");
	ОткрытьФорму(СтрСоединить(ЧастиИмени, "."), ПараметрыВыбора, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеВыбораРасширений", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

	ОчиститьСообщения();
	Если Не ЗначениеЗаполнено(Расширение) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Выберите расширение.'");
		Сообщение.Поле = "Расширение";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Результат - Массив из Строка - отмеченные расширения; Неопределено - выбор отменен.
&НаКлиенте
Процедура ПослеВыбораРасширений(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Расширение = СтрСоединить(Результат, ", ");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СодержитВсеСлова(Представление, Слова)
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(Представление, Слово) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Процедура СформироватьНаСервере()
	РеквизитФормыВЗначение("Объект").ВывестиИзмененияРасширения(Результат, Расширение, ТолькоИзменения);
КонецПроцедуры

&НаСервере
Функция РасширенияБазы()
	Возврат РеквизитФормыВЗначение("Объект").РасширенияБазы();
КонецФункции

#КонецОбласти
