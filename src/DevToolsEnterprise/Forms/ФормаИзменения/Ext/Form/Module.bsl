#Область ОписаниеПеременных

&НаКлиенте
Перем ВсеОбъектыМетаданных; // СписокЗначений - для автоподбора, см. ОбъектыМетаданных.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Элементы.ПолноеИмяОбъекта.СписокВыбора.ЗагрузитьЗначения(ОтчетОбъект.ОбъектыРасширений());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Совпадает с обработчиком формы ФормаПрава.
&НаКлиенте
Процедура ПолноеИмяОбъектаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Слова = СтрРазделить(НРег(СокрЛП(Текст)), " ", Ложь);
	Если Слова.Количество() = 0 Или СтрДлина(Слова[0]) < 2 Тогда
		Возврат;
	КонецЕсли;

	Если ВсеОбъектыМетаданных = Неопределено Тогда
		ВсеОбъектыМетаданных = ОбъектыМетаданных();
	КонецЕсли;

	// Ищутся объекты, в имени или синониме которых есть все введенные слова.
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ВсеОбъектыМетаданных Цикл
		Представление = НРег(ЭлементСписка.Представление);
		Подходит = Истина;
		Для Каждого Слово Из Слова Цикл
			Если СтрНайти(Представление, Слово) = 0 Тогда
				Подходит = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Подходит Тогда
			ДанныеВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
			Если ДанныеВыбора.Количество() = 50 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРасширения(Команда)

	// Открывается форма выгрузки, в которой отмечены расширения, выведенные в отчет.
	// Если отчет еще не сформирован, он сначала формируется.
	Если Не ОтчетСформирован Тогда
		СформироватьНаСервере();
	КонецЕсли;

	// Каждое открытие - новая форма: отметки берутся из текущего результата отчета.
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	ЧастиИмени[ЧастиИмени.ВГраница()] = "ФормаВыгрузкаРасширений";
	ОткрытьФорму(СтрСоединить(ЧастиИмени, "."), Новый Структура("Расширения", ВыведенныеРасширения), ,
		Новый УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()

	ИменаРасширений = РеквизитФормыВЗначение("Объект").ВывестиИзмененияВРасширениях(Результат, ПолноеИмяОбъекта,
		ТолькоИзменения);
	ВыведенныеРасширения.ЗагрузитьЗначения(ИменаРасширений);
	ОтчетСформирован = Истина;

КонецПроцедуры

&НаСервере
Функция ОбъектыМетаданных()
	Возврат РеквизитФормыВЗначение("Объект").ОбъектыМетаданных();
КонецФункции

#КонецОбласти
