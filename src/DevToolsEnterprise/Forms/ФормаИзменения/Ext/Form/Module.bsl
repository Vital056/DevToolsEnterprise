#Область ОписаниеПеременных

&НаКлиенте
Перем ВсеОбъектыМетаданных; // СписокЗначений - для автоподбора, см. ОбъектыМетаданных.

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// В поле можно перечислить несколько объектов через запятую: подбор идет по тексту после
// последней запятой (или точки с запятой), выбранный объект дописывается к уже введенным.
// Поиск по словам - как в форме ФормаПрава.
&НаКлиенте
Процедура ПолноеИмяОбъектаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	ПозицияРазделителя = Макс(СтрНайти(Текст, ",", НаправлениеПоиска.СКонца),
		СтрНайти(Текст, ";", НаправлениеПоиска.СКонца));
	Начало = СокрП(Лев(Текст, ПозицияРазделителя));
	Если ЗначениеЗаполнено(Начало) Тогда
		Начало = Начало + " ";
	КонецЕсли;

	Слова = СтрРазделить(НРег(СокрЛП(Сред(Текст, ПозицияРазделителя + 1))), " ", Ложь);
	Если Слова.Количество() = 0 Или СтрДлина(Слова[0]) < 2 Тогда
		Возврат;
	КонецЕсли;

	Если ВсеОбъектыМетаданных = Неопределено Тогда
		ВсеОбъектыМетаданных = ОбъектыМетаданных();
	КонецЕсли;

	// Уже введенные объекты повторно не предлагаются.
	Введенные = Новый Соответствие;
	Для Каждого ВведенноеИмя Из СтрРазделить(НРег(Начало), ",; ", Ложь) Цикл
		Введенные.Вставить(ВведенноеИмя, Истина);
	КонецЦикла;

	// Ищутся объекты, в имени или синониме которых есть все введенные слова.
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ВсеОбъектыМетаданных Цикл
		Если Введенные[НРег(ЭлементСписка.Значение)] = Неопределено
			И СодержитВсеСлова(НРег(ЭлементСписка.Представление), Слова) Тогда
			ДанныеВыбора.Добавить(Начало + ЭлементСписка.Значение, ЭлементСписка.Представление);
			Если ДанныеВыбора.Количество() = 50 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПолноеИмяОбъектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	ЧастиИмени[ЧастиИмени.ВГраница()] = "ФормаВыбораОбъектов";
	ОткрытьФорму(СтрСоединить(ЧастиИмени, "."), Новый Структура("Выбранные", ПолноеИмяОбъекта), ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеВыбораОбъектов", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьРасширения(Команда)

	// Открывается форма выгрузки, в которой отмечены расширения, выведенные в отчет.
	// Если отчет еще не сформирован, он сначала формируется.
	Если Не ОтчетСформирован Тогда
		СформироватьНаСервере();
	КонецЕсли;

	// Каждое открытие - новая форма: отметки берутся из текущего результата отчета.
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	ЧастиИмени[ЧастиИмени.ВГраница()] = "ФормаВыгрузкаРасширений";
	ОткрытьФорму(СтрСоединить(ЧастиИмени, "."), Новый Структура("Расширения", ВыведенныеРасширения), ,
		Новый УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция СодержитВсеСлова(Представление, Слова)
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(Представление, Слово) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Результат - Массив из Строка - отмеченные объекты; Неопределено - выбор отменен.
&НаКлиенте
Процедура ПослеВыбораОбъектов(Результат, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		ПолноеИмяОбъекта = СтрСоединить(Результат, ", ");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	ИменаРасширений = РеквизитФормыВЗначение("Объект").ВывестиИзмененияВРасширениях(Результат, ПолноеИмяОбъекта,
		ТолькоИзменения);
	ВыведенныеРасширения.ЗагрузитьЗначения(ИменаРасширений);
	ОтчетСформирован = Истина;

КонецПроцедуры

&НаСервере
Функция ОбъектыМетаданных()
	Возврат РеквизитФормыВЗначение("Объект").ОбъектыМетаданных();
КонецФункции

#КонецОбласти
