// Право, неприменимое к объекту этого вида, ПравоДоступа отвергает исключением.
Функция ПрименимыеПрава(ОбъектМетаданных, Роль)

	Права = Новый Массив;
	Для Каждого Право Из ВсеПрава() Цикл
		Попытка
			ПравоДоступа(Право, ОбъектМетаданных, Роль);
			Права.Добавить(Право);
		Исключение
			// Право неприменимо к объекту этого вида.
		КонецПопытки;
	КонецЦикла;

	Возврат Права;

