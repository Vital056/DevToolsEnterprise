#Область ЧтениеКонтейнера

// Читает записи контейнера и готовит их к распаковке.
//
// Возвращаемое значение:
//   Структура:
//     * Записи - Соответствие - ключ: имя записи, значение: сжатые ДвоичныеДанные.
//     * Номера - Соответствие - ключ: UUID, значение: Массив номеров записей "<UUID>.<номер>".
//     * Каталог - Строка - временный каталог.
//     * Zip - ЧтениеZipФайла - архив со всеми записями.
//     * ИменаВZip - Соответствие - ключ: имя записи, значение: имя файла в архиве.
//
Функция НовыйКонтейнер(ДанныеРасширения)

	Записи = ЗаписиКонтейнера(ДанныеРасширения);
	Если Записи = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестный формат данных расширения.'");
	КонецЕсли;

	Номера = Новый Соответствие;
	Для Каждого КлючИЗначение Из Записи Цикл
		ЧастиИмени = СтрРазделить(КлючИЗначение.Ключ, ".");
		Если СтрДлина(ЧастиИмени[0]) <> 36 Тогда
			Продолжить;
		КонецЕсли;
		НомераUUID = Номера[ЧастиИмени[0]];
		Если НомераUUID = Неопределено Тогда
			НомераUUID = Новый Массив;
			Номера.Вставить(ЧастиИмени[0], НомераUUID);
		КонецЕсли;
		Если ЧастиИмени.Количество() = 2 Тогда
			НомераUUID.Добавить(ЧастиИмени[1]);
		КонецЕсли;
	КонецЦикла;

	Каталог = ПолучитьИмяВременногоФайла("cfe");
	СоздатьКаталог(Каталог);
	ИмяАрхива = Каталог + ПолучитьРазделительПутиСервера() + "data.zip";
	ИменаВZip = ЗаписатьАрхив(ИмяАрхива, Записи);

	Контейнер = Новый Структура("Записи, Номера, Каталог, Zip, ИменаВZip", Записи, Номера, Каталог,
		Неопределено, ИменаВZip);
	Контейнер.Zip = Новый ЧтениеZipФайла(ИмяАрхива);

	Возврат Контейнер;

КонецФункции

Процедура ЗакрытьКонтейнер(Контейнер)

	Если Контейнер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Контейнер.Zip <> Неопределено Тогда
		Контейнер.Zip.Закрыть();
	КонецЕсли;
	Попытка
		УдалитьФайлы(Контейнер.Каталог);
	Исключение
		// Временный каталог удалит платформа.
	КонецПопытки;

КонецПроцедуры

// Возвращаемое значение:
//   ДвоичныеДанные, Неопределено - распакованное содержимое записи.
//
Функция Распаковать(Контейнер, ИмяЗаписи)

	ИмяВZip = Контейнер.ИменаВZip[ИмяЗаписи];
	Если ИмяВZip = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЭлементАрхива = Контейнер.Zip.Элементы.Найти(ИмяВZip);
	ИмяФайла = Контейнер.Каталог + ПолучитьРазделительПутиСервера() + ИмяВZip;

	// Контрольная сумма и размер распакованных данных заранее не известны, поэтому
	// платформа сообщает об ошибке, но лишь после того, как записала файл целиком.
	Попытка
		Контейнер.Zip.Извлечь(ЭлементАрхива, Контейнер.Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	Исключение
		// Ожидаемая ошибка контрольной суммы, проверяется наличие файла.
	КонецПопытки;

	Файл = Новый Файл(ИмяФайла);
	Если Не Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось распаковать запись %1.'"), ИмяЗаписи);
	КонецЕсли;

	Результат = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);

	Возврат Результат;

КонецФункции

Функция ТекстЗаписи(Контейнер, ИмяЗаписи)
	Возврат ТекстИзДанных(Распаковать(Контейнер, ИмяЗаписи));
КонецФункции

Функция ТекстИзДанных(Данные)

	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Если СтрНачинаетсяС(Текст, Символ(65279)) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Формат контейнера: заголовок 16 байт (первое значение 0x7FFFFFFF), затем оглавление -
// тройки адресов (заголовок записи, данные записи, 0x7FFFFFFF). Каждый документ хранится
// в цепочке блоков с заголовком "\r\n<размер документа> <размер блока> <следующий блок> \r\n".
//
// Возвращаемое значение:
//   Соответствие - ключ: имя записи, значение: ДвоичныеДанные записи.
//   Неопределено - данные не являются контейнером.
//
Функция ЗаписиКонтейнера(Данные)

	Если Данные = Неопределено Или Данные.Размер() < 16 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Если Буфер.ПрочитатьЦелое32(0, ПорядокБайтов.LittleEndian) <> КонецЦепочки() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Оглавление = ДокументКонтейнера(Буфер, 16);

	Записи = Новый Соответствие;
	Для Номер = 0 По Цел(Оглавление.Размер / 12) - 1 Цикл

		АдресЗаголовка = Оглавление.ПрочитатьЦелое32(Номер * 12, ПорядокБайтов.LittleEndian);
		АдресДанных = Оглавление.ПрочитатьЦелое32(Номер * 12 + 4, ПорядокБайтов.LittleEndian);

		Заголовок = ДокументКонтейнера(Буфер, АдресЗаголовка);
		Имя = ПолучитьСтрокуИзБуфераДвоичныхДанных(Заголовок.Прочитать(20, Заголовок.Размер - 20), "UTF-16LE");
		КонецИмени = СтрНайти(Имя, Символ(0));
		Если КонецИмени > 0 Тогда
			Имя = Лев(Имя, КонецИмени - 1);
		КонецЕсли;

		Если АдресДанных <> КонецЦепочки() Тогда
			Записи.Вставить(Имя, ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ДокументКонтейнера(Буфер, АдресДанных)));
		КонецЕсли;

	КонецЦикла;

	Возврат Записи;

КонецФункции

Функция ДокументКонтейнера(Буфер, Знач Адрес)

	Блоки = Новый Массив;
	РазмерДокумента = -1;
	Пока Адрес <> КонецЦепочки() Цикл

		Если Адрес + 31 > Буфер.Размер Или Блоки.Количество() > Буфер.Размер Тогда
			ВызватьИсключение НСтр("ru = 'Нарушена структура данных расширения.'");
		КонецЕсли;

		Заголовок = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(Адрес, 31), КодировкаТекста.ANSI);
		Если РазмерДокумента < 0 Тогда
			РазмерДокумента = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Заголовок, 3, 8));
		КонецЕсли;
		РазмерБлока = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Заголовок, 12, 8));
		Следующий = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Заголовок, 21, 8));

		Блоки.Добавить(Буфер.Прочитать(Адрес + 31, Мин(РазмерБлока, Буфер.Размер - Адрес - 31)));
		Адрес = Следующий;

	КонецЦикла;

	Документ = СоединитьБуферыДвоичныхДанных(Блоки);
	Если Документ.Размер > РазмерДокумента Тогда
		Документ = Документ.Прочитать(0, РазмерДокумента);
	КонецЕсли;

	Возврат Документ;

КонецФункции

Функция КонецЦепочки()
	Возврат 2147483647; // 0x7FFFFFFF
КонецФункции

// Пишет записи в ZIP-архив как файлы со сжатием deflate. Контрольная сумма не задана,
// а размер распакованных данных указан максимальным, см. Распаковать.
//
// Возвращаемое значение:
//   Соответствие - ключ: имя записи, значение: имя файла в архиве.
//
Функция ЗаписатьАрхив(ИмяАрхива, Записи)

	ИменаВZip = Новый Соответствие;
	Файлы = Новый Массив;
	МаксимальныйРазмер = 2147483647;

	Запись = Новый ЗаписьДанных(ИмяАрхива, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);
	Позиция = 0;
	Для Каждого КлючИЗначение Из Записи Цикл

		Размер = КлючИЗначение.Значение.Размер();
		Если Размер = 0 Тогда
			Продолжить;
		КонецЕсли;

		ИмяВZip = "e" + Формат(Файлы.Количество() + 1, "ЧГ=0");
		ИменаВZip.Вставить(КлючИЗначение.Ключ, ИмяВZip);
		Файлы.Добавить(Новый Структура("Имя, Размер, Смещение", ИмяВZip, Размер, Позиция));

		Запись.ЗаписатьЦелое32(67324752); // 0x04034B50, локальный заголовок
		Запись.ЗаписатьЦелое16(20);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(8); // deflate
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое32(0); // CRC-32
		Запись.ЗаписатьЦелое32(Размер);
		Запись.ЗаписатьЦелое32(МаксимальныйРазмер);
		Запись.ЗаписатьЦелое16(СтрДлина(ИмяВZip));
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьСимволы(ИмяВZip);
		Запись.Записать(КлючИЗначение.Значение);

		Позиция = Позиция + 30 + СтрДлина(ИмяВZip) + Размер;

	КонецЦикла;

	НачалоКаталога = Позиция;
	Для Каждого ФайлАрхива Из Файлы Цикл
		Запись.ЗаписатьЦелое32(33639248); // 0x02014B50, центральный каталог
		Запись.ЗаписатьЦелое16(20);
		Запись.ЗаписатьЦелое16(20);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(8);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое32(0);
		Запись.ЗаписатьЦелое32(ФайлАрхива.Размер);
		Запись.ЗаписатьЦелое32(МаксимальныйРазмер);
		Запись.ЗаписатьЦелое16(СтрДлина(ФайлАрхива.Имя));
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое16(0);
		Запись.ЗаписатьЦелое32(0);
		Запись.ЗаписатьЦелое32(ФайлАрхива.Смещение);
		Запись.ЗаписатьСимволы(ФайлАрхива.Имя);
		Позиция = Позиция + 46 + СтрДлина(ФайлАрхива.Имя);
	КонецЦикла;

	Запись.ЗаписатьЦелое32(101010256); // 0x06054B50, конец центрального каталога
	Запись.ЗаписатьЦелое16(0);
	Запись.ЗаписатьЦелое16(0);
	Запись.ЗаписатьЦелое16(Файлы.Количество());
	Запись.ЗаписатьЦелое16(Файлы.Количество());
	Запись.ЗаписатьЦелое32(Позиция - НачалоКаталога);
	Запись.ЗаписатьЦелое32(НачалоКаталога);
	Запись.ЗаписатьЦелое16(0);
	Запись.Закрыть();

	Возврат ИменаВZip;

КонецФункции

