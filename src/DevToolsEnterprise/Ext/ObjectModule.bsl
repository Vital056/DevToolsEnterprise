#Область ВыводОтчетов

// Только в отчете: формы отчета выводят результат в табличный документ этими процедурами.
// Ни строки, ни колонки табличного документа не закрепляются, шапка таблицы прокручивается вместе с ней.

// Выводит дерево "объект -> расширение -> элемент" строками табличного документа.
// Строки расширений и элементов сгруппированы, их можно сворачивать.
//
// Параметры:
//   ТабДок - ТабличныйДокумент - куда выводить, предыдущее содержимое очищается.
//   ПолноеИмя - Строка - см. ИзмененияОбъекта.
//   ТолькоИзменения - Булево - см. ИзмененияОбъекта.
//
// Возвращаемое значение:
//   Массив из Строка - имена расширений, которые попали в отчет, без повторов.
//
Функция ВывестиИзмененияВРасширениях(ТабДок, Знач ПолноеИмя, ТолькоИзменения) Экспорт

	ПолноеИмя = СокрЛП(ПолноеИмя);
	Изменения = ИзмененияОбъекта(ПолноеИмя, ТолькоИзменения);

	ВыведенныеРасширения = Изменения.Скопировать(, "Расширение");
	ВыведенныеРасширения.Свернуть("Расширение");
	ИменаРасширений = ВыведенныеРасширения.ВыгрузитьКолонку("Расширение");

	Объекты = Изменения.Скопировать(, "Объект");
	Объекты.Свернуть("Объект");

	НачатьВывод(ТабДок);
	Ширины = СтрРазделить("55,18,60,25,12,10,12,14,14", ",");
	Для Индекс = 0 По Ширины.ВГраница() Цикл
		ТабДок.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = Число(Ширины[Индекс]);
	КонецЦикла;

	ТекстЗаголовка = СтрШаблон("Изменения в расширениях: %1",
		?(ЗначениеЗаполнено(ПолноеИмя), ПолноеИмя, "все объекты"));
	НомерСтроки = ВывестиЗаголовок(ТабДок, ТекстЗаголовка,
		ТекстСведенийИзменений(ПолноеИмя, ТолькоИзменения, Объекты.Количество()));

	Если Изменения.Количество() = 0 Тогда
		Возврат ИменаРасширений;
	КонецЕсли;

	НомерСтроки = НомерСтроки + 2;
	ВывестиШапку(ТабДок, НомерСтроки, СтрРазделить("Объект / расширение / элемент,Вид изменения,Подробности,"
		+ "Синоним расширения,Версия,Активно,Безопасный режим,Изменяет структуру данных,Назначение", ","));

	ЦветОбъекта = Новый Цвет(221, 235, 247);
	СтрокаОбъекта = 0;
	СтрокаРасширения = 0;
	ТекущийОбъект = Неопределено;
	ТекущееРасширение = Неопределено;

	Для Каждого Изменение Из Изменения Цикл

		Если Изменение.Объект <> ТекущийОбъект Тогда
			СгруппироватьСтроки(ТабДок, СтрокаРасширения, НомерСтроки);
			СгруппироватьСтроки(ТабДок, СтрокаОбъекта, НомерСтроки);
			ТекущийОбъект = Изменение.Объект;
			ТекущееРасширение = Неопределено;
			СтрокаРасширения = 0;

			НомерСтроки = НомерСтроки + 1;
			СтрокаОбъекта = НомерСтроки;
			ВывестиСтрокуИзменений(ТабДок, НомерСтроки, Изменение.Объект);
			Область = ТабДок.Область(НомерСтроки, 1, НомерСтроки, 9);
			ВыделитьЖирным(Область);
			Область.ЦветФона = ЦветОбъекта;
		КонецЕсли;

		Если Изменение.Расширение <> ТекущееРасширение Тогда
			СгруппироватьСтроки(ТабДок, СтрокаРасширения, НомерСтроки);
			ТекущееРасширение = Изменение.Расширение;

			НомерСтроки = НомерСтроки + 1;
			СтрокаРасширения = НомерСтроки;
			ВывестиСтрокуИзменений(ТабДок, НомерСтроки, Изменение.Расширение, , , Изменение.Синоним,
				Изменение.Версия, ПредставлениеФлага(Изменение.Активно), ПредставлениеФлага(Изменение.БезопасныйРежим),
				ПредставлениеФлага(Изменение.ИзменяетСтруктуруДанных), Изменение.Назначение);
			ЯчейкаРезультата(ТабДок, НомерСтроки, 1).Отступ = 2;
			ВыделитьЖирным(ТабДок.Область(НомерСтроки, 1, НомерСтроки, 9));
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		ВывестиСтрокуИзменений(ТабДок, НомерСтроки, Изменение.Элемент, Изменение.ВидИзменения, Изменение.Подробности);
		ЯчейкаРезультата(ТабДок, НомерСтроки, 1).Отступ = 4;

	КонецЦикла;

	СгруппироватьСтроки(ТабДок, СтрокаРасширения, НомерСтроки);
	СгруппироватьСтроки(ТабДок, СтрокаОбъекта, НомерСтроки);

	// Видны объекты и расширения; элементы раскрываются по требованию,
	// заимствованных реквизитов бывают десятки.
	ТабДок.ПоказатьУровеньГруппировокСтрок(1);

	Возврат ИменаРасширений;

КонецФункции

// Выводит матрицу "роль x право" и, если запрошены, ограничения прав на реквизиты.
//
// Параметры:
//   ТабДок - ТабличныйДокумент - куда выводить, предыдущее содержимое очищается.
//   ПолноеИмя - Строка - см. ПраваРолей.
//   ТолькоРолиСПравами - Булево - см. ПраваРолей.
//   ПраваНаРеквизиты - Булево - см. ПраваРолей.
//
Процедура ВывестиПраваРолей(ТабДок, ПолноеИмя, ТолькоРолиСПравами, ПраваНаРеквизиты) Экспорт

	Права = ПраваРолей(ПолноеИмя, ТолькоРолиСПравами, ПраваНаРеквизиты);

	НачатьВывод(ТабДок);
	ТабДок.Область(, 1, , 1).ШиринаКолонки = 30;
	ТабДок.Область(, 2, , 2).ШиринаКолонки = 30;
	ТабДок.Область(, 3, , 3).ШиринаКолонки = 22;
	Если Права.Права.Количество() > 0 Тогда
		// Шапка прав только расширяет колонки под короткие названия, см. ВывестиШапкуПрав.
		ТабДок.Область(, 4, , 3 + Права.Права.Количество()).ШиринаКолонки = 4;
	КонецЕсли;

	ТекстЗаголовка = СтрШаблон("Права ролей: %1", Права.Объект);
	Если ЗначениеЗаполнено(Права.Синоним) Тогда
		ТекстЗаголовка = СтрШаблон("%1 (%2)", ТекстЗаголовка, Права.Синоним);
	КонецЕсли;
	НомерСтроки = ВывестиЗаголовок(ТабДок, ТекстЗаголовка, ТекстСведенийПрав(Права, ТолькоРолиСПравами));

	Если Права.Права.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НомерСтроки = НомерСтроки + 2;
	ВывестиШапкуПрав(ТабДок, НомерСтроки, СтрРазделить("Роль,Синоним,Где определена", ","), Права.Права);

	Для Каждого СтрокаРоли Из Права.Роли Цикл
		НомерСтроки = НомерСтроки + 1;
		ЯчейкаТаблицы(ТабДок, НомерСтроки, 1, СтрокаРоли.Роль);
		ЯчейкаТаблицы(ТабДок, НомерСтроки, 2, СтрокаРоли.Синоним);
		Ячейка = ЯчейкаТаблицы(ТабДок, НомерСтроки, 3, СтрокаРоли.Источник);
		Если СтрокаРоли.ИзРасширения Тогда
			ВыделитьЖирным(Ячейка);
			ВыделитьЖирным(ЯчейкаРезультата(ТабДок, НомерСтроки, 1));
		КонецЕсли;
		Для Индекс = 0 По Права.Права.ВГраница() Цикл
			ЯчейкаФлага(ТабДок, НомерСтроки, 4 + Индекс, СтрокаРоли[Права.Права[Индекс]]);
		КонецЦикла;
	КонецЦикла;

	Если ПраваНаРеквизиты И Права.Права.Найти("Просмотр") <> Неопределено Тогда
		ВывестиПраваНаРеквизиты(ТабДок, НомерСтроки + 2, Права.Реквизиты);
	КонецЕсли;

КонецПроцедуры

Функция ТекстСведенийИзменений(ПолноеИмя, ТолькоИзменения, КоличествоОбъектов)

	Если Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат СтрШаблон("Объектов в расширениях: %1.", КоличествоОбъектов);
	КонецЕсли;

	ЕстьИзменения = ЕстьИзмененияВСеансе(ПолноеИмя);
	Если ЕстьИзменения = Неопределено Тогда
		ТекстСеанса = "объекта нет в основной конфигурации";
	ИначеЕсли ЕстьИзменения Тогда
		ТекстСеанса = "активные расширения сеанса его изменяют";
	Иначе
		ТекстСеанса = "активные расширения сеанса его не изменяют";
	КонецЕсли;

	Если КоличествоОбъектов = 0 И ТолькоИзменения Тогда
		ТекстРасширений = "расширения базы его не изменяют (только заимствуют или не содержат)";
	ИначеЕсли КоличествоОбъектов = 0 Тогда
		ТекстРасширений = "ни в одном расширении базы объект не найден";
	Иначе
		ТекстРасширений = "найден в расширениях (см. ниже)";
	КонецЕсли;

	Возврат СтрШаблон("%1: %2; %3.", ПолноеИмя, ТекстРасширений, ТекстСеанса);

КонецФункции

Процедура ВывестиСтрокуИзменений(ТабДок, НомерСтроки, Представление, ВидИзменения = "", Подробности = "",
	Синоним = "", Версия = "", Активно = "", БезопасныйРежим = "", ИзменяетСтруктуруДанных = "", Назначение = "")

	ЯчейкаТаблицы(ТабДок, НомерСтроки, 1, Представление);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 2, ВидИзменения);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 3, Подробности);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 4, Синоним);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 5, Версия);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 6, Активно);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 7, БезопасныйРежим);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 8, ИзменяетСтруктуруДанных);
	ЯчейкаТаблицы(ТабДок, НомерСтроки, 9, Назначение);

КонецПроцедуры

// Группирует строки под строкой-заголовком: от следующей за ней до ПоследняяСтрока.
Процедура СгруппироватьСтроки(ТабДок, СтрокаЗаголовка, ПоследняяСтрока)

	Если СтрокаЗаголовка > 0 И ПоследняяСтрока > СтрокаЗаголовка Тогда
		ТабДок.Область(СтрокаЗаголовка + 1, , ПоследняяСтрока).Сгруппировать();
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеФлага(Значение)
	Возврат ?(Значение, "Да", "Нет");
КонецФункции

Функция ТекстСведенийПрав(Права, ТолькоРолиСПравами)

	Строки = Новый Массив;

	Если ЗначениеЗаполнено(Права.Синоним) Тогда
		Строки.Добавить(СтрШаблон("%1 (%2): %3.", Права.Объект, Права.Синоним, Права.Источник));
	Иначе
		Строки.Добавить(СтрШаблон("%1: %2.", Права.Объект, Права.Источник));
	КонецЕсли;

	Если Права.Права.Количество() = 0 Тогда
		Строки.Добавить("Права на объекты этого вида в ролях не задаются.");
	ИначеЕсли ТолькоРолиСПравами Тогда
		Строки.Добавить(СтрШаблон("Ролей с правами на объект: %1 из %2.", Права.Роли.Количество(), Права.ВсегоРолей));
	Иначе
		Строки.Добавить(СтрШаблон("Ролей: %1.", Права.ВсегоРолей));
	КонецЕсли;

	ТекстРасширений = СтрШаблон("Учтены расширения сеанса: %1.",
		?(Права.РасширенияСеанса.Количество() = 0, "нет", СтрСоединить(Права.РасширенияСеанса, ", ")));
	Если Права.НеУчтенныеРасширения.Количество() > 0 Тогда
		ТекстРасширений = ТекстРасширений + СтрШаблон(
			" НЕ учтены (не применены в сеансе, их права проверить нельзя): %1.",
			СтрСоединить(Права.НеУчтенныеРасширения, ", "));
	КонецЕсли;
	Строки.Добавить(ТекстРасширений + " Ограничения доступа на уровне записей не проверяются.");

	Если Права.Права.Количество() > 0 Тогда
		Строки.Добавить("Названия прав в шапке сокращены: «И.» - интерактивное, «Пд» - предопределенные данные, "
			+ "«ИД.» - история данных. Полное название - в примечании ячейки шапки, наведите на нее указатель.");
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ВывестиПраваНаРеквизиты(ТабДок, Знач НомерСтроки, Реквизиты)

	Если Реквизиты.Количество() = 0 Тогда
		ЯчейкаРезультата(ТабДок, НомерСтроки, 1, "Права на реквизиты у всех ролей совпадают с правами на объект.");
		Возврат;
	КонецЕсли;

	ВыделитьЖирным(ЯчейкаРезультата(ТабДок, НомерСтроки, 1, "Реквизиты, на которые у роли меньше прав, чем на объект"));
	НомерСтроки = НомерСтроки + 1;
	ВывестиШапкуПрав(ТабДок, НомерСтроки, СтрРазделить("Роль,Реквизит,Где определен", ","),
		СтрРазделить("Просмотр,Редактирование", ","));

	Для Каждого СтрокаРеквизита Из Реквизиты Цикл
		НомерСтроки = НомерСтроки + 1;
		ЯчейкаТаблицы(ТабДок, НомерСтроки, 1, СтрокаРеквизита.Роль);
		ЯчейкаТаблицы(ТабДок, НомерСтроки, 2, СтрокаРеквизита.Реквизит);
		ЯчейкаТаблицы(ТабДок, НомерСтроки, 3, СтрокаРеквизита.Источник);
		ЯчейкаФлага(ТабДок, НомерСтроки, 4, СтрокаРеквизита.Просмотр);
		ЯчейкаФлага(ТабДок, НомерСтроки, 5, СтрокаРеквизита.Редактирование);
	КонецЦикла;

КонецПроцедуры

// Права в шапке - короткими названиями, чтобы шапка занимала одну строку, а колонки
// оставались узкими. Полное название - в примечании ячейки, оно видно при наведении указателя.
Процедура ВывестиШапкуПрав(ТабДок, НомерСтроки, Заголовки, Права)

	ВывестиШапку(ТабДок, НомерСтроки, Заголовки);

	КраткиеНазвания = КраткиеНазванияПрав();
	Для Индекс = 0 По Права.ВГраница() Цикл
		Название = КраткиеНазвания.Получить(Права[Индекс]);
		Если Название = Неопределено Тогда
			Название = Права[Индекс];
		КонецЕсли;

		// Таблица прав на реквизиты делит колонки с матрицей ролей, ширина берется большая.
		НомерКолонки = Заголовки.Количество() + 1 + Индекс;
		Колонка = ТабДок.Область(, НомерКолонки, , НомерКолонки);
		Колонка.ШиринаКолонки = Макс(Колонка.ШиринаКолонки, СтрДлина(Название) + 3);

		Ячейка = ЯчейкаТаблицы(ТабДок, НомерСтроки, НомерКолонки, Название);
		ВыделитьЖирным(Ячейка);
		Ячейка.ЦветФона = ЦветШапки();
		Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
		Ячейка.Примечание.Текст = ПредставлениеПрава(Права[Индекс]);
	КонецЦикла;

КонецПроцедуры

// Короткие названия прав из ВсеПрава: "И." - интерактивное, "Пд" - предопределенные данные,
// "ИД." - история данных.
//
// Возвращаемое значение:
//   Соответствие - ключ: имя права, значение: короткое название.
//
Функция КраткиеНазванияПрав()

	Пары = СтрРазделить(
		"Чтение=Чт,Добавление=Доб,Изменение=Изм,Удаление=Уд,Проведение=Пров,ОтменаПроведения=ОтмПр,"
		+ "Просмотр=Просм,ИнтерактивноеДобавление=И.Доб,Редактирование=Ред,ИнтерактивноеУдаление=И.Уд,"
		+ "ИнтерактивнаяПометкаУдаления=И.Пом,ИнтерактивноеСнятиеПометкиУдаления=И.СнПом,"
		+ "ИнтерактивноеУдалениеПомеченных=И.УдПом,ИнтерактивноеПроведение=И.Пров,"
		+ "ИнтерактивноеПроведениеНеОперативное=И.ПрНеОп,ИнтерактивнаяОтменаПроведения=И.ОтмПр,"
		+ "ИнтерактивноеИзменениеПроведенных=И.ИзмПр,ВводПоСтроке=ВвСтр,"
		+ "ИнтерактивноеУдалениеПредопределенныхДанных=И.УдПд,"
		+ "ИнтерактивнаяПометкаУдаленияПредопределенныхДанных=И.ПомПд,"
		+ "ИнтерактивноеСнятиеПометкиУдаленияПредопределенныхДанных=И.СнПомПд,"
		+ "ИнтерактивноеУдалениеПомеченныхПредопределенныхДанных=И.УдПомПд,"
		+ "Использование=Исп,Получение=Получ,Установка=Устан,Старт=Старт,ИнтерактивныйСтарт=И.Старт,"
		+ "ИнтерактивнаяАктивация=И.Актив,Выполнение=Вып,ИнтерактивноеВыполнение=И.Вып,УправлениеИтогами=Итоги,"
		+ "ЧтениеИсторииДанных=ИД.Чт,ПросмотрИсторииДанных=ИД.Просм,ИзменениеИсторииДанных=ИД.Изм,"
		+ "ЧтениеИсторииДанныхОтсутствующихДанных=ИД.ЧтОтс,ИзменениеИсторииДанныхОтсутствующихДанных=ИД.ИзмОтс,"
		+ "ИзменениеНастроекИсторииДанных=ИД.Настр,ИзменениеКомментарияВерсииИсторииДанных=ИД.ИзмКом,"
		+ "РедактированиеКомментарияВерсииИсторииДанных=ИД.РедКом,ПереходНаВерсиюИсторииДанных=ИД.Перех,"
		+ "Администрирование=Адм,АдминистрированиеДанных=АдмДан,ОбновлениеКонфигурацииБазыДанных=ОбнБД,"
		+ "МонопольныйРежим=Моно,АктивныеПользователи=АктПольз,ЖурналРегистрации=ЖР,ТонкийКлиент=Тонк,"
		+ "ВебКлиент=Веб,МобильныйКлиент=Моб,ТолстыйКлиент=Толст,ВнешнееСоединение=ВнСоед,Automation=Auto,"
		+ "РежимВсеФункции=ВсеФ,СохранениеДанныхПользователя=СохрДП,АдминистрированиеРасширенийКонфигурации=АдмРасш,"
		+ "ИнтерактивноеОткрытиеВнешнихОбработок=И.ВнОбр,ИнтерактивноеОткрытиеВнешнихОтчетов=И.ВнОтч,Вывод=Вывод", ",");

	КраткиеНазвания = Новый Соответствие;
	Для Каждого Пара Из Пары Цикл
		Части = СтрРазделить(Пара, "=");
		КраткиеНазвания.Вставить(Части[0], Части[1]);
	КонецЦикла;

	Возврат КраткиеНазвания;

КонецФункции

Процедура ЯчейкаФлага(ТабДок, НомерСтроки, НомерКолонки, Значение)

	Ячейка = ЯчейкаТаблицы(ТабДок, НомерСтроки, НомерКолонки, ?(Значение, "✓", ""));
	Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Если Значение Тогда
		Ячейка.ЦветФона = Новый Цвет(226, 239, 218);
	КонецЕсли;

КонецПроцедуры

Процедура НачатьВывод(ТабДок)

	ТабДок.Очистить();
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьГруппировки = Истина;
	ТабДок.ФиксацияСверху = 0;
	ТабДок.ФиксацияСлева = 0;

КонецПроцедуры

// Выводит заголовок отчета и под ним строки сведений.
//
// Возвращаемое значение:
//   Число - номер последней выведенной строки.
//
Функция ВывестиЗаголовок(ТабДок, ТекстЗаголовка, Сведения)

	Ячейка = ЯчейкаРезультата(ТабДок, 1, 1, ТекстЗаголовка);
	Ячейка.Шрифт = Новый Шрифт(Ячейка.Шрифт, , 12, Истина);

	НомерСтроки = 1;
	Для Каждого СтрокаСведений Из СтрРазделить(Сведения, Символы.ПС) Цикл
		НомерСтроки = НомерСтроки + 1;
		ЯчейкаРезультата(ТабДок, НомерСтроки, 1, СтрокаСведений).ЦветТекста = Новый Цвет(96, 96, 96);
	КонецЦикла;

	Возврат НомерСтроки;

КонецФункции

Процедура ВывестиШапку(ТабДок, НомерСтроки, Заголовки)

	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Ячейка = ЯчейкаТаблицы(ТабДок, НомерСтроки, 1 + Индекс, Заголовки[Индекс]);
		ВыделитьЖирным(Ячейка);
		Ячейка.ЦветФона = ЦветШапки();
		Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	КонецЦикла;

КонецПроцедуры

// Шрифт строится от шрифта ячейки: без основы конструктор берет шрифт стиля, он крупнее
// шрифта табличного документа.
Процедура ВыделитьЖирным(Область)
	Область.Шрифт = Новый Шрифт(Область.Шрифт, , , Истина);
КонецПроцедуры

Функция ЦветШапки()
	Возврат Новый Цвет(242, 242, 242);
КонецФункции

Функция ЯчейкаРезультата(ТабДок, НомерСтроки, НомерКолонки, Текст = Неопределено)

	Ячейка = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Если Текст <> Неопределено Тогда
		Ячейка.Текст = Текст;
	КонецЕсли;

	Возврат Ячейка;

КонецФункции

Функция ЯчейкаТаблицы(ТабДок, НомерСтроки, НомерКолонки, Текст)

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);

	Ячейка = ЯчейкаРезультата(ТабДок, НомерСтроки, НомерКолонки, Текст);
	Ячейка.Обвести(Линия, Линия, Линия, Линия);
	Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Ячейка.ВертикальноеПоложение = ВертикальноеПоложение.Верх;

	Возврат Ячейка;

КонецФункции

#КонецОбласти

