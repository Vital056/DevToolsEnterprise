// Реквизиты объекта, на которые права задаются в ролях отдельно: стандартные реквизиты
// (проверяются по имени), реквизиты, измерения, ресурсы, табличные части и их реквизиты.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя - Строка - представление реквизита.
//     * Реквизит - ОбъектМетаданных, Неопределено - Неопределено у стандартного реквизита.
//     * ИмяСтандартного - Строка - имя стандартного реквизита.
//     * Источник - Строка - где определен реквизит.
//
Функция РеквизитыСПравами(ОбъектМетаданных, Роль, Расширения)

	Кандидаты = Новый Массив;

	СтандартныеРеквизиты = КоллекцияИлиНеопределено(ОбъектМетаданных, "СтандартныеРеквизиты");
	Если СтандартныеРеквизиты <> Неопределено Тогда
		ИсточникОбъекта = ИсточникЭлемента(ОбъектМетаданных, Расширения);
		Для Каждого СтандартныйРеквизит Из СтандартныеРеквизиты Цикл
			Кандидаты.Добавить(Новый Структура("Имя, Реквизит, ИмяСтандартного, Источник",
				СтандартныйРеквизит.Имя, Неопределено, СтандартныйРеквизит.Имя, ИсточникОбъекта));
		КонецЦикла;
	КонецЕсли;

	ИменаКоллекций = ИменаПодчиненныхКоллекций();
	Для Каждого ИмяКоллекции Из СтрРазделить("Реквизиты,Измерения,Ресурсы,РеквизитыАдресации,ТабличныеЧасти", ",") Цикл

		Коллекция = КоллекцияИлиНеопределено(ОбъектМетаданных, ИмяКоллекции);
		Если Коллекция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Элемент Из Коллекция Цикл
			ИмяЭлемента = ИменаКоллекций[ИмяКоллекции] + "." + Элемент.Имя;
			Кандидаты.Добавить(Новый Структура("Имя, Реквизит, ИмяСтандартного, Источник",
				ИмяЭлемента, Элемент, "", ИсточникЭлемента(Элемент, Расширения)));
			Если ИмяКоллекции = "ТабличныеЧасти" Тогда
				Для Каждого РеквизитТЧ Из Элемент.Реквизиты Цикл
					Кандидаты.Добавить(Новый Структура("Имя, Реквизит, ИмяСтандартного, Источник",
						ИмяЭлемента + ".Реквизит." + РеквизитТЧ.Имя, РеквизитТЧ, "",
						ИсточникЭлемента(РеквизитТЧ, Расширения)));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	// Реквизиты, к которым права неприменимы, отсеиваются заранее, чтобы не перехватывать
	// исключения в цикле по ролям.
	Реквизиты = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Попытка
			ПравоНаРеквизит("Просмотр", ОбъектМетаданных, Кандидат, Роль);
			ПравоНаРеквизит("Редактирование", ОбъектМетаданных, Кандидат, Роль);
			Реквизиты.Добавить(Кандидат);
		Исключение
			// Права на реквизит задаются только вместе с объектом.
		КонецПопытки;
	КонецЦикла;

	Возврат Реквизиты;

КонецФункции

Функция ПравоНаРеквизит(Право, ОбъектМетаданных, Реквизит, Роль)

	Если Реквизит.Реквизит = Неопределено Тогда
		Возврат ПравоДоступа(Право, ОбъектМетаданных, Роль, Реквизит.ИмяСтандартного);
	КонецЕсли;

	Возврат ПравоДоступа(Право, Реквизит.Реквизит, Роль);

КонецФункции

// Право на реквизит действует вместе с правом на объект, поэтому выводятся только
// реквизиты, где роль дает меньше, чем на объект.
Процедура ДобавитьПраваНаРеквизиты(ПраваНаРеквизиты, ОбъектМетаданных, Роль, ПраваРоли, Реквизиты)

	Для Каждого Реквизит Из Реквизиты Цикл

		Просмотр = ПраваРоли.Просмотр И ПравоНаРеквизит("Просмотр", ОбъектМетаданных, Реквизит, Роль);
		Редактирование = ПраваРоли.Редактирование
			И ПравоНаРеквизит("Редактирование", ОбъектМетаданных, Реквизит, Роль);
		Если Просмотр = ПраваРоли.Просмотр И Редактирование = ПраваРоли.Редактирование Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ПраваНаРеквизиты.Добавить();
		НоваяСтрока.Роль = Роль.Имя;
		НоваяСтрока.Реквизит = Реквизит.Имя;
		НоваяСтрока.Источник = Реквизит.Источник;
		НоваяСтрока.Просмотр = Просмотр;
		НоваяСтрока.Редактирование = Редактирование;

	КонецЦикла;

КонецПроцедуры

// Возвращаемое значение:
//   Структура:
//     * Сеанса - Массив из РасширениеКонфигурации - расширения, примененные в сеансе.
//     * ИменаСеанса - Массив из Строка - их имена.
//     * НеУчтенные - Массив из Строка - имена расширений базы, не примененных в сеансе.
//     * Метаданные - Соответствие, Неопределено - ключ: имя расширения, значение: его
//                    ОбъектМетаданныхКонфигурация; заполняется при первом обращении.
//
Функция НовыеСведенияРасширений()

	Сведения = Новый Структура("Сеанса, ИменаСеанса, НеУчтенные, Метаданные",
		РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные),
		Новый Массив, Новый Массив, Неопределено);

	Для Каждого Расширение Из Сведения.Сеанса Цикл
		Сведения.ИменаСеанса.Добавить(Расширение.Имя);
	КонецЦикла;

	Для Каждого Расширение Из РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.БазаДанных) Цикл
		Если Сведения.ИменаСеанса.Найти(Расширение.Имя) = Неопределено Тогда
			Сведения.НеУчтенные.Добавить(Расширение.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Сведения;

КонецФункции

// Описывает, где определен объект метаданных, роль или реквизит: в конфигурации или
// в расширении. Для объекта конфигурации, измененного расширениями, перечисляет
// расширения сеанса, в которых он заимствован.
Функция ИсточникЭлемента(ЭлементМетаданных, Расширения)

	Расширение = ЭлементМетаданных.РасширениеКонфигурации();
	Если Расширение <> Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'расширение %1'"), Расширение.Имя);
	ИначеЕсли Не ЭлементМетаданных.ЕстьИзмененияРасширениямиКонфигурации() Тогда
		Возврат НСтр("ru = 'конфигурация'");
	КонецЕсли;

	Если Расширения.Метаданные = Неопределено Тогда
		Расширения.Метаданные = Новый Соответствие;
		Для Каждого Расширение Из Расширения.Сеанса Цикл
			Расширения.Метаданные.Вставить(Расширение.Имя,
				Новый ОбъектМетаданныхКонфигурация(Расширение.ПолучитьДанные()));
		КонецЦикла;
	КонецЕсли;

	ПолноеИмя = ЭлементМетаданных.ПолноеИмя();
	Заимствован = Новый Массив;
	Для Каждого КлючИЗначение Из Расширения.Метаданные Цикл
		Если КлючИЗначение.Значение.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено Тогда
			Заимствован.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Заимствован.Количество() = 0 Тогда
		Возврат НСтр("ru = 'конфигурация, изменения в расширениях'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'конфигурация, изменения в расширениях: %1'"), СтрСоединить(Заимствован, ", "));

КонецФункции

#КонецОбласти

#Область АнализДанныхРасширения

// Читает двоичные данные расширения (формат .cfe) и для каждого объекта находит код
// в его модулях и в модулях его команд, а также изменения заимствованных форм.
//
// Данные расширения - контейнер 1С: записи с именами вида "<UUID объекта>[.<номер>]",
// содержимое сжато deflate без заголовка. Встроенный язык такого сжатия не
// распаковывает, поэтому записи кладутся в ZIP-архив и извлекаются ЧтениеZipФайла
// (см. НовыйКонтейнер).
// - "<UUID>" - описание объекта, в нем есть имя и UUID подчиненных элементов;
// - "<UUID>.<номер>" с вложенным контейнером "text" - модуль объекта или команды;
// - "<UUID формы>.0" вида "{4,{описание формы},"текст модуля",...,{4,{описание базовой
//   формы},...}}" - управляемая форма. У заимствованной формы без изменений модуль
//   пуст, а описание совпадает с описанием базовой формы.
//
// Параметры:
//   ДанныеРасширения - ДвоичныеДанные - результат РасширениеКонфигурации.ПолучитьДанные().
//   ОбъектыРасширения - Массив из ОбъектМетаданных - объекты, которые нужно проверить.
//
// Возвращаемое значение:
//   Соответствие - ключ: полное имя объекта, значение - см. НовыеСведенияОбъекта.
//
Функция АнализДанныхРасширения(ДанныеРасширения, ОбъектыРасширения)

	Результат = Новый Соответствие;
	Для Каждого ОбъектРасширения Из ОбъектыРасширения Цикл
		Результат.Вставить(ОбъектРасширения.ПолноеИмя(), НовыеСведенияОбъекта());
	КонецЦикла;

	Контейнер = Неопределено;
	Попытка

		Контейнер = НовыйКонтейнер(ДанныеРасширения);
		ОбъектыКонтейнера = ОбъектыКонтейнера(Контейнер);

		Для Каждого ОбъектРасширения Из ОбъектыРасширения Цикл
			Сведения = Результат[ОбъектРасширения.ПолноеИмя()];
			ОбъектКонтейнера = НайтиОбъектКонтейнера(ОбъектыКонтейнера, ОбъектРасширения);
			Если ОбъектКонтейнера = Неопределено Тогда
				Сведения.Ошибка = НСтр("ru = 'Код не проверен: объект не найден в данных расширения.'");
			Иначе
				ПроанализироватьОбъект(Контейнер, ОбъектКонтейнера, ОбъектРасширения, Сведения);
			КонецЕсли;
		КонецЦикла;

	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Код не проверен: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Для Каждого КлючИЗначение Из Результат Цикл
			КлючИЗначение.Значение.Ошибка = ТекстОшибки;
		КонецЦикла;
	КонецПопытки;

	ЗакрытьКонтейнер(Контейнер);

	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//   Структура:
//     * Модули - Массив из Структура - модули с кодом и измененная общая форма:
//                Элемент, ВидИзменения, Подробности.
//     * Формы - Соответствие - ключ: имя заимствованной формы, значение: что в ней
//               изменено; пустая строка - форма только заимствована.
//     * Ошибка - Строка - почему код не удалось проверить.
//
Функция НовыеСведенияОбъекта()
	Возврат Новый Структура("Модули, Формы, Ошибка", Новый Массив, Новый Соответствие, "");
КонецФункции

Процедура ПроанализироватьОбъект(Контейнер, ОбъектКонтейнера, ОбъектРасширения, Сведения)

	UUIDОбъекта = ОбъектКонтейнера.UUID;
	Описание = ОбъектКонтейнера.Описание;
	ВидОбъекта = СтрРазделить(ОбъектРасширения.ПолноеИмя(), ".")[0];

	// Модули самого объекта. У общей формы в записи "<UUID>.0" лежит сама форма.
	Заимствован = ОбъектРасширения.ПринадлежностьОбъекта = Метаданные.СвойстваОбъектов.ПринадлежностьОбъекта.Заимствованный;
	Для Каждого Номер Из Контейнер.Номера[UUIDОбъекта] Цикл
		Данные = Распаковать(Контейнер, UUIDОбъекта + "." + Номер);
		Если Номер = "0" И ВидОбъекта = "ОбщаяФорма" Тогда
			ИзмененияФормы = ?(Заимствован, ИзмененияФормы(ТекстИзДанных(Данные)), "");
			Если ЗначениеЗаполнено(ИзмененияФормы) Тогда
				Сведения.Модули.Добавить(Новый Структура("Элемент, ВидИзменения, Подробности",
					"Форма", "изменена", ИзмененияФормы));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		АнализКода = АнализКодаМодуля(Данные);
		Если АнализКода <> Неопределено И АнализКода.ЕстьКод Тогда
			Сведения.Модули.Добавить(Новый Структура("Элемент, ВидИзменения, Подробности",
				ИмяМодуля(ВидОбъекта, Номер), "код", ОписаниеПерехватов(АнализКода.Перехваты)));
		КонецЕсли;
	КонецЦикла;

	// Формы и команды объекта упоминаются в его описании по UUID.
	Для Каждого КлючИЗначение Из Контейнер.Номера Цикл

		UUIDЭлемента = КлючИЗначение.Ключ;
		Если UUIDЭлемента = UUIDОбъекта Или СтрНайти(Описание, UUIDЭлемента) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если КлючИЗначение.Значение.Найти("0") <> Неопределено Тогда
			ДанныеФормы = Распаковать(Контейнер, UUIDЭлемента + ".0");
			ТекстФормы = ТекстИзДанных(ДанныеФормы);
			Если СтрНачинаетсяС(ТекстФормы, "{4,") Тогда
				ИмяФормы = ИмяИзОписания(ТекстЗаписи(Контейнер, UUIDЭлемента), UUIDЭлемента);
				Сведения.Формы.Вставить(ИмяФормы, ИзмененияФормы(ТекстФормы));
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Для Каждого Номер Из КлючИЗначение.Значение Цикл
			АнализКода = АнализКодаМодуля(Распаковать(Контейнер, UUIDЭлемента + "." + Номер));
			Если АнализКода <> Неопределено И АнализКода.ЕстьКод Тогда
				ИмяЭлемента = ИмяИзОписания(Описание, UUIDЭлемента);
				Сведения.Модули.Добавить(Новый Структура("Элемент, ВидИзменения, Подробности",
					"Команда." + ?(ЗначениеЗаполнено(ИмяЭлемента), ИмяЭлемента, UUIDЭлемента) + ".МодульКоманды",
					"код", ОписаниеПерехватов(АнализКода.Перехваты)));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Номер записи модуля зависит от вида объекта; проверены справочники, документы,
// регистры сведений, общие модули, отчеты и обработки.
Функция ИмяМодуля(ВидОбъекта, Номер)

	Если Номер = "0" Тогда
		Если ВидОбъекта = "ОбщийМодуль" Тогда
			Возврат "Модуль";
		ИначеЕсли ВидОбъекта = "Справочник" Или ВидОбъекта = "Документ"
			Или ВидОбъекта = "Отчет" Или ВидОбъекта = "Обработка" Тогда
			Возврат "МодульОбъекта";
		КонецЕсли;
	ИначеЕсли Номер = "1" И СтрНачинаетсяС(ВидОбъекта, "Регистр") Тогда
		Возврат "МодульНабораЗаписей";
	ИначеЕсли Номер = "2" И ВидОбъекта = "Документ" Тогда
		Возврат "МодульМенеджера";
	ИначеЕсли Номер = "3" И ВидОбъекта = "Справочник" Тогда
		Возврат "МодульМенеджера";
	КонецЕсли;

	Возврат СтрШаблон("Модуль (%1)", Номер);

КонецФункции

// Параметры:
//   ТекстФормы - Строка - содержимое записи "<UUID формы>.0".
//
// Возвращаемое значение:
//   Строка - что изменено в форме; пустая строка - форма только заимствована.
//
Функция ИзмененияФормы(ТекстФормы)

	// Строки в формате 1С заключены в кавычки, кавычка внутри строки удваивается.
	// Поэтому после разделения по кавычке четные части лежат вне строк, нечетные - внутри.
	Части = СтрРазделить(ТекстФормы, """", Истина);

	Глубина = 0;
	Смещение = 0;
	Начало = 0;
	Конец = 0;
	ИндексКонца = -1;
	Для Индекс = 0 По Части.ВГраница() Цикл

		Часть = Части[Индекс];
		Если Индекс % 2 = 0 Тогда
			Открыто = СтрЧислоВхождений(Часть, "{");
			Закрыто = СтрЧислоВхождений(Часть, "}");
			// Посимвольно разбираются только части, где начинается или заканчивается
			// описание формы, остальные - подсчетом скобок.
			Если Начало = 0 И Глубина + Открыто >= 2 Или Начало > 0 И Глубина - Закрыто <= 1 Тогда
				Для Позиция = 1 По СтрДлина(Часть) Цикл
					Символ = Сред(Часть, Позиция, 1);
					Если Символ = "{" Тогда
						Глубина = Глубина + 1;
						Если Глубина = 2 И Начало = 0 Тогда
							Начало = Смещение + Позиция;
						КонецЕсли;
					ИначеЕсли Символ = "}" Тогда
						Глубина = Глубина - 1;
						Если Глубина = 1 И Начало > 0 Тогда
							Конец = Смещение + Позиция;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Если Конец > 0 Тогда
					ИндексКонца = Индекс;
					Прервать;
				КонецЕсли;
			Иначе
				Глубина = Глубина + Открыто - Закрыто;
			КонецЕсли;
		КонецЕсли;
		Смещение = Смещение + СтрДлина(Часть) + 1;

	КонецЦикла;

	Если ИндексКонца < 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось разобрать описание формы.'");
	КонецЕсли;

	// Сразу за описанием формы идет строка с текстом ее модуля.
	ЧастиМодуля = Новый Массив;
	Индекс = ИндексКонца + 1;
	Пока Индекс <= Части.ВГраница() Цикл
		ЧастиМодуля.Добавить(Части[Индекс]);
		Если Индекс + 1 > Части.ВГраница() Или Части[Индекс + 1] <> "" Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 2;
	КонецЦикла;
	АнализКода = АнализКода(СтрСоединить(ЧастиМодуля, """"));

	Изменения = Новый Массив;
	Если АнализКода.ЕстьКод Тогда
		Изменения.Добавить(СтрШаблон(НСтр("ru = 'код модуля: %1'"), ОписаниеПерехватов(АнализКода.Перехваты)));
	КонецЕсли;

	// Если форма в расширении не менялась, ее описание повторяется в описании базовой формы.
	ОписаниеФормы = Сред(ТекстФормы, Начало, Конец - Начало + 1);
	Если СтрНайти(ТекстФормы, ОписаниеФормы, НаправлениеПоиска.СНачала, Конец + 1) = 0 Тогда
		Изменения.Добавить(НСтр("ru = 'изменены элементы, реквизиты, команды или обработчики формы'"));
	КонецЕсли;

	Возврат СтрСоединить(Изменения, "; ");

КонецФункции

// Возвращаемое значение:
//   Неопределено - запись не является модулем.
//   Структура - см. АнализКода.
//
Функция АнализКодаМодуля(Данные)

	Записи = ЗаписиКонтейнера(Данные);
	Если Записи = Неопределено Или Записи["text"] = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат АнализКода(ТекстИзДанных(Записи["text"]));

КонецФункции

// Возвращаемое значение:
//   Структура:
//     * ЕстьКод - Булево - в модуле есть что-то кроме комментариев и инструкций препроцессора.
//     * Перехваты - Массив из Строка - аннотации &Перед, &После, &Вместо, &ИзменениеИКонтроль.
//
Функция АнализКода(ТекстМодуля)

	Результат = Новый Структура("ЕстьКод, Перехваты", Ложь, Новый Массив);

	Аннотации = СтрРазделить("&Перед(,&После(,&Вместо(,&ИзменениеИКонтроль(,&Before(,&After(,&Around(,&ChangeAndValidate(", ",");
	Для Каждого СтрокаМодуля Из СтрРазделить(ТекстМодуля, Символы.ПС, Ложь) Цикл
		СтрокаКода = СокрЛП(СтрокаМодуля);
		Если СтрокаКода = "" Или СтрНачинаетсяС(СтрокаКода, "//") Или СтрНачинаетсяС(СтрокаКода, "#") Тогда
			Продолжить;
		КонецЕсли;
		Результат.ЕстьКод = Истина;
		Для Каждого Аннотация Из Аннотации Цикл
			Если СтрНачинаетсяС(СтрокаКода, Аннотация) Тогда
				Результат.Перехваты.Добавить(СтрокаКода);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеПерехватов(Перехваты)

	Если Перехваты.Количество() = 0 Тогда
		Возврат НСтр("ru = 'собственные процедуры, перехватов нет'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'перехваты %1'"), СтрСоединить(Перехваты, ", "));

КонецФункции

// Находит объекты верхнего уровня в описании конфигурации расширения.
//
// Возвращаемое значение:
//   Соответствие - ключ: имя объекта, значение: Массив из Структура (UUID, Класс, Описание).
//
Функция ОбъектыКонтейнера(Контейнер)

	Сведения = ТекстЗаписи(Контейнер, "configinfo");
	Позиция = СтрНайти(Сведения, "{2,");
	Если Позиция = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не найдено описание конфигурации расширения.'");
	КонецЕсли;
	UUIDКонфигурации = Сред(Сведения, Позиция + 3, 36);
	ОписаниеКонфигурации = ТекстЗаписи(Контейнер, UUIDКонфигурации);

	// Описание конфигурации перечисляет объекты по классам: {<класс>,<количество>,<UUID>,...}.
	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из Контейнер.Номера Цикл

		UUIDОбъекта = КлючИЗначение.Ключ;
		Позиция = СтрНайти(ОписаниеКонфигурации, UUIDОбъекта);
		Если UUIDОбъекта = UUIDКонфигурации Или Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;

		НачалоСписка = СтрНайти(ОписаниеКонфигурации, "{", НаправлениеПоиска.СКонца, Позиция);
		Класс = Сред(ОписаниеКонфигурации, НачалоСписка + 1, 36);

		Описание = ТекстЗаписи(Контейнер, UUIDОбъекта);
		Имя = ИмяИзОписания(Описание, UUIDОбъекта);
		Если Не ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;

		Объекты = Результат[Имя];
		Если Объекты = Неопределено Тогда
			Объекты = Новый Массив;
			Результат.Вставить(Имя, Объекты);
		КонецЕсли;
		Объекты.Добавить(Новый Структура("UUID, Класс, Описание", UUIDОбъекта, Класс, Описание));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Объекты разных видов могут называться одинаково, тогда вид определяется по классу.
Функция НайтиОбъектКонтейнера(ОбъектыКонтейнера, ОбъектРасширения)

	Кандидаты = ОбъектыКонтейнера[ОбъектРасширения.Имя];
	Если Кандидаты = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0];
	КонецЕсли;

	ВидОбъекта = СтрРазделить(ОбъектРасширения.ПолноеИмя(), ".")[0];
	ВидыПоКлассам = ВидыОбъектовПоКлассам();
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ВидыПоКлассам[Кандидат.Класс] = ВидОбъекта Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Классы сверены с выгрузкой расширений в XML.
Функция ВидыОбъектовПоКлассам()

	Виды = Новый Соответствие;
